# ========================
# Database
# ========================
POSTGRES_DB=affiliate_db
POSTGRES_USER=affiliate_user
POSTGRES_PASSWORD=affiliate_pass

# ========================
# Redis
# ========================
# (Không cần thêm biến nếu dùng mặc định)

# ========================
# API
# ========================
API_PORT=3000
NODE_ENV=development

# Thời gian xử lý trung bình 1 job (giây) - đo lường thực tế: 35-45s, lấy 40s
AVG_JOB_SECONDS=40

# ========================
# Automation (Appium + Playwright) — xem automation.md
# ========================
# appium = dùng điện thoại Android thật | simulation = mock khi dev không có thiết bị
AUTOMATION_MODE=appium

# Đường dẫn adb (Windows ví dụ: C:\platform-tools\platform-tools\adb.exe)
ADB_PATH=adb

# Appium server
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# Serial thiết bị (để trống = tự chọn thiết bị đầu tiên)
# ANDROID_DEVICE_SERIAL=

# Playwright headless khi trích xuất affiliate từ trang bộ sưu tập
PLAYWRIGHT_HEADLESS=true
