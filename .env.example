# ========================
# Database
# ========================
POSTGRES_DB=affiliate_db
POSTGRES_USER=affiliate_user
POSTGRES_PASSWORD=affiliate_pass

# Cổng host của container Postgres.
# Mặc định 5433 vì máy dev thường đã có PostgreSQL cài sẵn chiếm 5432.
POSTGRES_HOST_PORT=5433

# Dùng khi chạy API/worker TRỰC TIẾP TRÊN MÁY (không trong container).
# Worker bắt buộc chạy trên host vì cần gọi adb/Appium tới điện thoại qua USB.
DATABASE_URL=postgres://affiliate_user:affiliate_pass@localhost:5433/affiliate_db
REDIS_URL=redis://localhost:6379

# ========================
# API
# ========================
API_PORT=3000
NODE_ENV=development

# Thời gian xử lý trung bình 1 job (giây).
#
# Đo thật 2026-08-17 sau nhóm A + B2: ~40 s khi session Appium còn ấm (job nối
# nhau), ~48-56 s cho job đầu sau quãng nghỉ dài. Đo qua giao diện web: 40,2 /
# 40,3 / 50,3 s tính từ lúc người dùng bấm nút.
#
# Để 45 là hơi thừa một chút — thà báo lâu hơn thực tế còn hơn hứa non.
# Con số này hiển thị cho người dùng nên phải đúng — xem CLAUDE.md §10.6.
# NHỚ SỬA CẢ `config.ts` (giá trị mặc định) khi thời gian thật thay đổi: .env
# luôn ghi đè nên một giá trị sai trong code có thể nằm im rất lâu.
AVG_JOB_SECONDS=45

# Thời hạn giữ link affiliate trong Redis (giây).
# Link do YouTube sinh ra có hạn dùng nên KHÔNG lưu vào DB; hết TTL thì API
# trả result_expired=true và người dùng cần tạo job mới.
RESULT_TTL_SECONDS=2700

# ========================
# Automation (Appium + Playwright)
# ========================
# appium = điều khiển điện thoại Android thật | simulation = mock khi không có thiết bị
AUTOMATION_MODE=appium

# Đường dẫn adb (Windows ví dụ: C:\platform-tools\platform-tools\adb.exe)
ADB_PATH=adb

# Appium server (cần Appium 3.x + driver uiautomator2 8.x cho Android 13+)
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# Serial thiết bị (để trống = tự chọn thiết bị đầu tiên đang kết nối)
ANDROID_DEVICE_SERIAL=

# ID kênh YouTube — dùng cho deep link mở thẳng màn Mua sắm,
# bỏ qua 2 bước điều hướng dễ gãy. BẮT BUỘC khi AUTOMATION_MODE=appium.
YT_CHANNEL_ID=

# Bộ sưu tập cần gắn sản phẩm vào (để trống = thẻ đầu tiên trên màn Mua sắm).
# NÊN ĐẶT TƯỜNG MINH: có tên mới tra được link chia sẻ trong cache Redis ngay từ
# đầu job, nhờ đó Phase 2 (~19 giây thao tác Appium) được bỏ qua hoàn toàn. Bỏ
# trống thì tên bộ sưu tập chỉ biết sau khi Phase 1 chạy xong, cache luôn trượt.
YT_COLLECTION_NAME=

# Giữ session Appium sống giữa các job, tiết kiệm ~10-15 giây mỗi job.
# App vẫn được force-stop ở đầu mỗi job nên trạng thái vẫn sạch; session cũng bị
# huỷ sau mỗi job thất bại để lần retry bắt đầu hoàn toàn mới.
# Đặt 0 khi cần loại trừ nguyên nhân lúc gỡ rối.
#
# LƯU Ý: cờ này chỉ có tác dụng khi job sau tới TRƯỚC lúc Appium tự đóng session.
# Ngưỡng đó là `newCommandTimeout` trong appiumYoutubeStudio.ts, đã nới từ 300s
# lên 3600s vì mức 300s khiến mọi job cách nhau quá 5 phút đều phải dựng lại —
# tức gần như mọi job ở lưu lượng thấp, làm phần tiết kiệm này chỉ đúng trên giấy.
APPIUM_REUSE_SESSION=1

# Bỏ hẳn bước OCR đọc tên sản phẩm (~2,6 giây/job).
# CHỈ bật sau khi log vài job thật cho thấy bước trích link luôn thắng bằng dòng
# "khớp ID sản phẩm trong origin_link". Bật sớm sẽ làm job mất cả hai đường so
# khớp sản phẩm và hỏng ở bước cuối.
AUTOMATION_SKIP_PRODUCT_OCR=0

# Chụp ảnh mốc trên đường thành công (gỡ rối). Tắt mặc định vì tốn ~600ms/tấm.
# DRY_RUN=1 tự bật; đặt 0 để tắt tường minh khi cần đo tốc độ.
AUTOMATION_CHECKPOINT_SHOTS=0

# Playwright headless khi trích xuất affiliate từ trang bộ sưu tập
PLAYWRIGHT_HEADLESS=true


# Độ trễ ngẫu nhiên giữa các thao tác, chống bị nhận diện là bot (CLAUDE.md §10.5).
# TẮT mặc định từ 2026-08-17 theo quyết định của chủ dự án, đổi 9,5 giây/job.
#
# ĐÂY LÀ QUYẾT ĐỊNH RỦI RO TÀI KHOẢN, KHÔNG PHẢI TỐI ƯU KỸ THUẬT. Hệ thống chỉ có
# MỘT tài khoản YouTube đủ điều kiện — mất là dừng toàn bộ.
# ĐẶT LẠI =1 NGAY nếu thấy: captcha trong app, Google đòi xác minh thiết bị,
# thao tác bị chặn hoặc chậm bất thường, cảnh báo hoạt động đáng ngờ.
AUTOMATION_HUMAN_DELAY=0
