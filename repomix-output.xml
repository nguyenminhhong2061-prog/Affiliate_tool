# Script kiểm thử tự động toàn bộ API Giai đoạn 1 (hỗ trợ tạo user_id duy nhất cho mỗi lần chạy)
$baseUrl = "http://localhost:3000"
$ts = Get-Date -Format "HHmmss"
$userA = "user_A_$ts"
$userB = "user_B_$ts"
