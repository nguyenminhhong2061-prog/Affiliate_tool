        await el.click();
        foundCollection = true;
        await humanDelay(2000, 3000);
        break;
      }
    }
    if (!foundCollection) console.log('ℹ️ Đang quét tiếp các phần tử trên trang Mua sắm.');

    const ss3 = path.join(SCREENSHOT_DIR, 'mobile_3_collection_detail.png');
