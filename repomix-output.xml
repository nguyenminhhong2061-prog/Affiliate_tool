# 3. Thử tạo Job thứ 2 cho User A (Duplicate Check)
Write-Host "[Test 3/6] Thử tạo trùng Job cho User A (Kỳ vọng lỗi 409 Conflict)..." -ForegroundColor Yellow
try {
    $dup = Invoke-RestMethod -Uri "$baseUrl/api/v1/jobs" -Method Post -Body $bodyUserA -ContentType "application/json"
    Write-Host "  ❌ FAILED: Hệ thống không chặn được job trùng.`n" -ForegroundColor Red
} catch {
    $statusCode = $_.Exception.Response.StatusCode.value__
    if ($statusCode -eq 409) {
        Write-Host "  ✅ SUCCESS: Hệ thống đã chặn thành công! (HTTP 409 Conflict - Bạn đang có 1 job chưa hoàn thành)`n" -ForegroundColor Green
    } else {
        Write-Host "  ❌ FAILED: Trả về mã lỗi khác: $statusCode`n" -ForegroundColor Red
    }
}

# 4. Tạo Job cho User B (Kiểm tra vị trí hàng đợi)
Write-Host "[Test 4/6] Tạo Job mới cho User B ($userB)..." -ForegroundColor Yellow
$bodyUserB = @{
    shopee_url = "https://shopee.vn/product/999999/888888"
    user_id = $userB
} | ConvertTo-Json

$jobB = Invoke-RestMethod -Uri "$baseUrl/api/v1/jobs" -Method Post -Body $bodyUserB -ContentType "application/json"
Write-Host "  ✅ SUCCESS: Tạo Job B thành công!" -ForegroundColor Green
Write-Host "     - Job ID: $($jobB.job_id)"
Write-Host "     - Vị trí hàng đợi: $($jobB.queue_position)"
Write-Host "     - Thời gian chờ ước tính: $($jobB.estimated_wait_seconds)s`n"

# 5. Tra cứu chi tiết Job A (GET /api/v1/jobs/:id)
Write-Host "[Test 5/6] Tra cứu chi tiết Job A (GET /api/v1/jobs/$($jobA.job_id))..." -ForegroundColor Yellow
$detailA = Invoke-RestMethod -Uri "$baseUrl/api/v1/jobs/$($jobA.job_id)" -Method Get
Write-Host "  ✅ SUCCESS: Lấy chi tiết Job A thành công!" -ForegroundColor Green
Write-Host "     - Trạng thái: $($detailA.status)"
Write-Host "     - Tên sản phẩm: $($detailA.product.name)"
Write-Host "     - Link gốc: $($detailA.product.original_url)`n"

# 6. Test Validate Link Shopee sai format
Write-Host "[Test 6/6] Gửi link không phải Shopee (Kỳ vọng lỗi 400 Bad Request)..." -ForegroundColor Yellow
$bodyInvalid = @{
    shopee_url = "https://google.com"
    user_id = $userC
} | ConvertTo-Json

try {
    $inv = Invoke-RestMethod -Uri "$baseUrl/api/v1/jobs" -Method Post -Body $bodyInvalid -ContentType "application/json"
    Write-Host "  ❌ FAILED: Không chặn được link sai.`n" -ForegroundColor Red
} catch {
    $statusCode = $_.Exception.Response.StatusCode.value__
    if ($statusCode -eq 400) {
        Write-Host "  ✅ SUCCESS: Đã chặn link không hợp lệ! (HTTP 400 Bad Request)`n" -ForegroundColor Green
    } else {
        Write-Host "  ❌ FAILED: Trả về mã lỗi khác: $statusCode`n" -ForegroundColor Red
    }
}

Write-Host "=========================================" -ForegroundColor Cyan
Write-Host " 🎉 HOÀN THÀNH TẤT CẢ KỊCH BẢN KIỂM THỬ!" -ForegroundColor Cyan
Write-Host "=========================================" -ForegroundColor Cyan
</file>

<file path="test-automation.ps1">
# Script kiểm thử Playwright Worker & Circuit Breaker (Giai đoạn 3)
$baseUrl = "http://localhost:3000"
$ts = Get-Date -Format "HHmmss"

Write-Host "=========================================================" -ForegroundColor Cyan
Write-Host " 🚀 KỊCH BẢN KIỂM THỬ PLAYWRIGHT WORKER & CIRCUIT BREAKER (GIAI ĐOẠN 3)" -ForegroundColor Cyan
Write-Host "=========================================================`n" -ForegroundColor Cyan

# 1. Tạo Job cho Playwright Worker xử lý
Write-Host "[Test 1/3] Tạo Job mới cho Playwright Worker..." -ForegroundColor Yellow
$user = "pw_user_$ts"
$jobRes = Invoke-RestMethod -Uri "$baseUrl/api/v1/jobs" -Method Post -Body (@{ shopee_url = "https://shopee.vn/product/777/888"; user_id = $user } | ConvertTo-Json) -ContentType "application/json"
Write-Host "  ✅ SUCCESS: Đã tạo Job ID: $($jobRes.job_id) (Product: $($jobRes.product.name))`n"

# 2. Theo dõi Playwright Worker thực thi
Write-Host "[Test 2/3] Theo dõi Playwright Automation Engine xử lý..." -ForegroundColor Yellow
$maxRetries = 15
$jobDone = $false

for ($i = 1; $i -le $maxRetries; $i++) {
    Start-Sleep -Seconds 1
    $statusCheck = Invoke-RestMethod -Uri "$baseUrl/api/v1/jobs/$($jobRes.job_id)" -Method Get
    Write-Host "  [Lần $i] Trạng thái Job: '$($statusCheck.status)'" -ForegroundColor Gray
    
    if ($statusCheck.status -eq "done") {
        $jobDone = $true
        Write-Host "  ✅ SUCCESS: Playwright Worker đã hoàn thành xuất sắc!" -ForegroundColor Green
        Write-Host "     - Link Affiliate: $($statusCheck.result.affiliate_url)"
        Write-Host "     - Mã Voucher: $($statusCheck.result.voucher)`n"
        break
    }
}

if (-not $jobDone) {
    Write-Host "  ❌ FAILED: Job chưa hoàn thành trong thời gian dự kiến.`n" -ForegroundColor Red
}

# 3. Kiểm tra Circuit Breaker & CLI Save Session Helper
Write-Host "[Test 3/3] Kiểm tra công cụ Quản lý Session & Circuit Breaker..." -ForegroundColor Yellow
$saveSessionScript = "packages/api/src/scripts/saveSession.ts"
if (Test-Path $saveSessionScript) {
    Write-Host "  ✅ SUCCESS: Script CLI đăng nhập thủ công 1 lần (saveSession.ts) đã sẵn sàng." -ForegroundColor Green
    Write-Host "     - Lệnh chạy khi Admin cần cập nhật cookie YouTube Studio: npm run save-session`n"
}

Write-Host "=========================================================" -ForegroundColor Cyan
Write-Host " 🎉 HOÀN THÀNH KIỂM THỬ PLAYWRIGHT AUTOMATION GIAI ĐOẠN 3!" -ForegroundColor Cyan
Write-Host "=========================================================" -ForegroundColor Cyan
</file>

<file path="test-queue.ps1">
# Script kiểm thử hàng đợi BullMQ (Giai đoạn 2)
$baseUrl = "http://localhost:3000"
$ts = Get-Date -Format "HHmmss"

Write-Host "=========================================================" -ForegroundColor Cyan
Write-Host " 🚀 KỊCH BẢN KIỂM THỬ HÀNG ĐỢI BULLMQ & WORKER (GIAI ĐOẠN 2)" -ForegroundColor Cyan
Write-Host "=========================================================`n" -ForegroundColor Cyan

# 1. Kiểm tra Bull Board Admin Dashboard UI
Write-Host "[Test 1/4] Kiểm tra Dashboard Quản trị Hàng đợi (/admin/queues)..." -ForegroundColor Yellow
try {
    $dashboardRes = Invoke-WebRequest -Uri "$baseUrl/admin/queues" -Method Get
    if ($dashboardRes.StatusCode -eq 200) {
        Write-Host "  ✅ SUCCESS: Bull Board Dashboard đã hoạt động tại http://localhost:3000/admin/queues`n" -ForegroundColor Green
    }
} catch {
    Write-Host "  ❌ FAILED: Không truy cập được Bull Board Dashboard.`n" -ForegroundColor Red
}

# 2. Tạo 2 Job liên tiếp từ 2 User khác nhau
Write-Host "[Test 2/4] Gửi 2 Job liên tiếp vào Hàng đợi..." -ForegroundColor Yellow
$user1 = "q_user1_$ts"
$user2 = "q_user2_$ts"

$job1Res = Invoke-RestMethod -Uri "$baseUrl/api/v1/jobs" -Method Post -Body (@{ shopee_url = "https://shopee.vn/product/111/222"; user_id = $user1 } | ConvertTo-Json) -ContentType "application/json"
Write-Host "  -> Đã tạo Job 1 (User: $user1, Job ID: $($job1Res.job_id)) - Vị trí: $($job1Res.queue_position)"

$job2Res = Invoke-RestMethod -Uri "$baseUrl/api/v1/jobs" -Method Post -Body (@{ shopee_url = "https://shopee.vn/product/333/444"; user_id = $user2 } | ConvertTo-Json) -ContentType "application/json"
Write-Host "  -> Đã tạo Job 2 (User: $user2, Job ID: $($job2Res.job_id)) - Vị trí: $($job2Res.queue_position)`n"

# 3. Theo dõi trạng thái Job 1 chuyển từ processing -> done
Write-Host "[Test 3/4] Theo dõi Worker xử lý Job 1 (Kỳ vọng: pending -> processing -> done)..." -ForegroundColor Yellow
$maxRetries = 15
$job1Done = $false

for ($i = 1; $i -le $maxRetries; $i++) {
    Start-Sleep -Seconds 1
    $statusCheck = Invoke-RestMethod -Uri "$baseUrl/api/v1/jobs/$($job1Res.job_id)" -Method Get
    Write-Host "  [Lần $i] Trạng thái Job 1: '$($statusCheck.status)'" -ForegroundColor Gray
    
    if ($statusCheck.status -eq "done") {
        $job1Done = $true
        Write-Host "  ✅ SUCCESS: Job 1 đã được Worker xử lý hoàn thành!" -ForegroundColor Green
        Write-Host "     - Link Affiliate trả về: $($statusCheck.result.affiliate_url)"
        Write-Host "     - Mã Voucher: $($statusCheck.result.voucher)`n"
        break
    }
}

if (-not $job1Done) {
    Write-Host "  ❌ FAILED: Job 1 chưa chuyển sang trạng thái done.`n" -ForegroundColor Red
}

# 4. Theo dõi Job 2 bắt đầu được xử lý tuần tự (Concurrency = 1)
Write-Host "[Test 4/4] Kiểm tra tính xử lý tuần tự (Job 2 hoàn thành sau Job 1)..." -ForegroundColor Yellow
$job2Status = Invoke-RestMethod -Uri "$baseUrl/api/v1/jobs/$($job2Res.job_id)" -Method Get
Write-Host "  -> Trạng thái Job 2 hiện tại: '$($job2Status.status)'"

if ($job2Status.status -eq "processing" -or $job2Status.status -eq "done") {
    Write-Host "  ✅ SUCCESS: Worker đã tự động tiếp nhận Job 2 sau khi Job 1 hoàn thành!`n" -ForegroundColor Green
} else {
    Write-Host "  ⏳ Job 2 vẫn đang chờ trong hàng đợi.`n" -ForegroundColor Yellow
}

Write-Host "=========================================================" -ForegroundColor Cyan
Write-Host " 🎉 HOÀN THÀNH KIỂM THỬ HÀNG ĐỢI GIAI ĐOẠN 2!" -ForegroundColor Cyan
Write-Host "=========================================================" -ForegroundColor Cyan
</file>

